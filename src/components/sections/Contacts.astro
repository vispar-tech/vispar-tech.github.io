---
import type { SiteContent } from "@/content/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { contacts } = content;
---

<section id="contacts" class="contacts">
  <div class="container">
    <h2>{contacts.heading}</h2>
    <p class="contacts__text">{contacts.text}</p>
    <div class="contacts__links">
      <a class="contacts__card" href={contacts.telegramUrl} rel="me noopener">
        <span class="contacts__label">Telegram</span>
        <span class="contacts__value">{contacts.telegramLabel}</span>
      </a>
      <a class="contacts__card" href={contacts.githubUrl} rel="me noopener">
        <span class="contacts__label">GitHub</span>
        <span class="contacts__value">{contacts.githubLabel}</span>
      </a>
      <div class="contacts__card contacts__card--email">
        <a class="contacts__email" href={`mailto:${contacts.email}`}>
          <span class="contacts__label">Email</span>
          <span class="contacts__value">{contacts.email}</span>
        </a>
        <button
          class="contacts__copy"
          type="button"
          data-copy-email={contacts.email}
          data-copied-label={contacts.copiedLabel}
        >
          {contacts.copyLabel}
        </button>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .contacts {
    h2 {
      margin-bottom: 0.75rem;
      font-size: clamp(1.5rem, 4vw, 2rem);
    }

    &__text {
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      max-width: 36rem;
    }

    &__links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      gap: 1rem;
    }

    &__card {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      background: var(--element);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.25rem;
      transition:
        border-color 0.15s ease,
        background-color 0.15s ease;

      &:hover {
        border-color: var(--neutral-600);
        background: var(--element-hover);
      }

      &--email {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0;
      }
    }

    &__email {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 1.1rem 0 1.1rem 1.25rem;
      min-width: 0;
    }

    &__copy {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      padding: 0.9rem 0.6rem;
      margin-right: 0.2rem;
      border-radius: var(--radius-sm);
      white-space: nowrap;
      transition: color 0.15s ease, background-color 0.15s ease;

      &:hover {
        color: var(--text);
        background: var(--element-hover);
      }
    }

    &__label {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    &__value {
      color: var(--text);
      overflow-wrap: anywhere;
    }
  }
</style>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-email]");

  if (copyBtn) {
    const email = copyBtn.dataset.copyEmail ?? "";
    const original = copyBtn.textContent ?? "";
    const copiedLabel = copyBtn.dataset.copiedLabel ?? "copied";

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        copyBtn.textContent = copiedLabel;
        setTimeout(() => {
          copyBtn.textContent = original;
        }, 1600);
      } catch {
        // clipboard unavailable — the mailto link remains the primary path
      }
    });
  }
</script>
