---
import type { SiteContent } from "@/content/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const avatar = "https://avatars.githubusercontent.com/u/85240536?v=4&s=256";
---

<section id="hero" class="hero">
  <div class="container hero__inner">
    <img
      class="hero__photo"
      src={avatar}
      alt={content.hero.photoAlt}
      width="128"
      height="128"
      loading="eager"
    />
    <p class="hero__prompt">{content.hero.prompt}</p>
    <h1 class="hero__name">{content.hero.name}</h1>
    <!-- TODO(T03): rotating typing effect over content.hero.roles; static first role for now -->
    <p class="hero__role">{content.hero.roles[0]}</p>
    <p class="hero__location">{content.hero.location}</p>
    <div class="hero__cta">
      <a class="hero__btn hero__btn--primary" href={content.hero.ctaPrimary.href}>
        {content.hero.ctaPrimary.label}
      </a>
      <a class="hero__btn" href={content.hero.ctaSecondary.href}>
        {content.hero.ctaSecondary.label}
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    padding-block: clamp(3rem, 12vh, 7rem);

    &__inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    &__photo {
      width: 128px;
      height: 128px;
      border-radius: 50%;
      border: 2px solid var(--border);
      margin-bottom: 1rem;
    }

    &__prompt {
      font-family: var(--font-mono);
      color: var(--accent);
      font-size: 0.95rem;
    }

    &__name {
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      font-weight: 700;
    }

    &__role {
      font-family: var(--font-mono);
      font-size: 1.15rem;
      color: var(--text-secondary);
    }

    &__location {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    &__cta {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    &__btn {
      border: 1px solid var(--border);
      background: var(--element);
      border-radius: var(--radius-md);
      padding: 0.65rem 1.4rem;
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        transform 0.15s ease;

      &:hover {
        background: var(--element-hover);
        border-color: var(--accent);
        color: var(--text);
        transform: translateY(-2px);
      }

      &--primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #191919;
        font-weight: 600;

        &:hover {
          background: var(--accent-hover);
          border-color: var(--accent-hover);
          color: #191919;
        }
      }
    }
  }
</style>
