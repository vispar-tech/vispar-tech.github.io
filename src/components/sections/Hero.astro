---
import type { SiteContent } from "@/content/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const avatar = "https://avatars.githubusercontent.com/u/85240536?v=4&s=256";
---

<section id="hero" class="hero">
  <div class="container hero__inner">
    <img
      class="hero__photo"
      src={avatar}
      alt={content.hero.photoAlt}
      width="128"
      height="128"
      loading="eager"
    />
    <p class="hero__prompt">{content.hero.prompt}</p>
    <h1 class="hero__name">{content.hero.name}</h1>
    <p class="hero__role">
      <span class="sr-only">{content.hero.roles.join(", ")}</span>
      <span class="hero__role-animated" data-roles={JSON.stringify(content.hero.roles)} aria-hidden="true"><span class="hero__role-text">{content.hero.roles[0]}</span><span class="hero__cursor">_</span></span>
    </p>
    <p class="hero__location">{content.hero.location}</p>
    <div class="hero__cta">
      <a class="hero__btn hero__btn--primary" href={content.hero.ctaPrimary.href}>
        {content.hero.ctaPrimary.label}
      </a>
      <a class="hero__btn" href={content.hero.ctaSecondary.href}>
        {content.hero.ctaSecondary.label}
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    padding-block: clamp(3rem, 12vh, 7rem);

    &__inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    &__photo {
      width: 128px;
      height: 128px;
      border-radius: 50%;
      border: 2px solid var(--border);
      margin-bottom: 1rem;
    }

    &__prompt {
      font-family: var(--font-mono);
      color: var(--accent);
      font-size: 0.95rem;
    }

    &__name {
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      font-weight: 700;
    }

    &__role {
      font-family: var(--font-mono);
      font-size: 1.15rem;
      color: var(--text-secondary);
      min-height: 1.5em;
    }

    &__cursor {
      color: var(--accent);

      @media (prefers-reduced-motion: no-preference) {
        animation: cursor-blink 1s steps(2, start) infinite;
      }
    }

    &__location {
      color: var(--text-muted);
      font-size: 0.95rem;
      font-family: var(--font-mono);

      &::before {
        content: "// ";
      }
    }

    &__cta {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    &__btn {
      border: 1px solid var(--border);
      background: var(--element);
      border-radius: var(--radius-md);
      padding: 0.65rem 1.4rem;
      font-family: var(--font-mono);
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        transform 0.15s ease;

      &:hover {
        background: var(--element-hover);
        border-color: var(--accent);
        color: var(--text);
        transform: translateY(-2px);
      }

      &--primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #191919;
        font-weight: 600;

        &:hover {
          background: var(--accent-hover);
          border-color: var(--accent-hover);
          color: #191919;
        }
      }
    }
  }

  @keyframes cursor-blink {
    to {
      visibility: hidden;
    }
  }
</style>

<script>
  const animated = document.querySelector<HTMLElement>(".hero__role-animated");
  const textEl = document.querySelector<HTMLElement>(".hero__role-text");

  if (animated && textEl && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const roles: string[] = JSON.parse(animated.dataset.roles ?? "[]");
    if (roles.length > 1) {
      const typeMs = 65;
      const deleteMs = 30;
      const holdMs = 2000;
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

      (async () => {
        let index = 0;
        for (;;) {
          await sleep(holdMs);
          while ((textEl.textContent?.length ?? 0) > 0) {
            textEl.textContent = textEl.textContent!.slice(0, -1);
            await sleep(deleteMs);
          }
          index = (index + 1) % roles.length;
          for (const ch of roles[index]) {
            textEl.textContent += ch;
            await sleep(typeMs);
          }
        }
      })();
    }
  }
</script>
