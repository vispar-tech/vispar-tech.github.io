---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { SiteContent } from "@/content/types";

interface Props {
  content: SiteContent;
  altLocalePath: string;
}

const { content, altLocalePath } = Astro.props;
const navLinks = [
  { label: content.nav.about, href: "#about" },
  { label: content.nav.experience, href: "#experience" },
  { label: content.nav.projects, href: "#projects" },
  { label: content.nav.stack, href: "#stack" },
  { label: content.nav.contacts, href: "#contacts" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={content.locale === "ru" ? "/" : "/en/"}>
      vispar<span>_tech</span>
    </a>
    <nav class="site-header__nav" aria-label="Main navigation">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <LanguageSwitcher currentLocale={content.locale} altLocalePath={altLocalePath} />
  </div>
</header>

<style lang="scss">
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(25, 25, 25, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);

    &__inner {
      height: var(--header-height);
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    &__logo {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--text);

      span {
        color: var(--accent);
      }
    }

    &__nav {
      margin-left: auto;

      ul {
        display: flex;
        gap: 1.25rem;
        list-style: none;
        padding: 0;
      }

      a {
        color: var(--text-secondary);
        font-size: 0.95rem;
        transition: color 0.15s ease;

        &:hover {
          color: var(--text);
        }
      }
    }
  }

  @media (max-width: 760px) {
    .site-header__nav {
      display: none;
    }

    .site-header__inner {
      justify-content: space-between;
    }
  }
</style>
