---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { SiteContent } from "@/content/types";

interface Props {
  content: SiteContent;
  altLocalePath: string;
}

const { content, altLocalePath } = Astro.props;
const navLinks = [
  { label: content.nav.about, href: "#about" },
  { label: content.nav.experience, href: "#experience" },
  { label: content.nav.projects, href: "#projects" },
  { label: content.nav.stack, href: "#stack" },
  { label: content.nav.contacts, href: "#contacts" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={content.locale === "ru" ? "/" : "/en/"}>
      vispar<span>_tech</span>
    </a>
    <nav class="site-header__nav" aria-label="Main navigation">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <LanguageSwitcher currentLocale={content.locale} altLocalePath={altLocalePath} />
      <!-- CSS-only mobile menu: no client JS needed -->
      <details class="mobile-nav">
        <summary aria-label={content.nav.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </summary>
        <nav aria-label="Mobile navigation">
          <ul>
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style lang="scss">
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(16, 16, 16, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);

    &__inner {
      height: var(--header-height);
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    &__logo {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--text);

      span {
        color: var(--accent);
      }
    }

    &__nav {
      margin-left: auto;

      ul {
        display: flex;
        gap: 1.25rem;
        list-style: none;
        padding: 0;
      }

      a {
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        transition: color 0.15s ease;

        &::before {
          content: "./";
          color: var(--text-muted);
        }

        &:hover {
          color: var(--text);
        }
      }
    }

    &__actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
  }

  .mobile-nav {
    display: none;

    summary {
      list-style: none;
      cursor: pointer;
      color: var(--text-secondary);
      display: flex;
      padding: 0.35rem;
      border-radius: var(--radius-sm);

      &:hover {
        color: var(--accent);
      }

      &::-webkit-details-marker {
        display: none;
      }
    }

    &[open] {
      position: relative;

      nav {
        position: absolute;
        right: 0;
        top: calc(100% + 0.5rem);
        background: var(--element);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 0.5rem;
        min-width: 11rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      }

      ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      a {
        display: block;
        padding: 0.55rem 0.9rem;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.95rem;

        &:hover {
          background: var(--element-hover);
          color: var(--text);
        }
      }
    }
  }

  @media (max-width: 760px) {
    .site-header__nav {
      display: none;
    }

    .site-header__actions {
      margin-left: auto;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
